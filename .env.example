# ==============================================================================
# Environment Configuration Template
# Copy this file to .env before starting the services
# ==============================================================================

# Node Environment
NODE_ENV=development

# Server Configuration
SERVER_PORT=5000
SERVER_HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173

# Runner Service Configuration
RUNNER_PORT=4000
RUNNER_HOST=0.0.0.0
RUNNER_URL="http://localhost:4000"
RUNNER_SECRET=dev_runner_secret_key_change_me_in_production

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=collab_editor
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/collab_editor?schema=public"

# Redis Configuration (Redis 7)
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
# Optional invite code for registration (leave blank to allow open registration)
REGISTRATION_CODE=

# Code Execution Sandbox Defaults
SANDBOX_TIMEOUT_MS=5000
SANDBOX_MEMORY_LIMIT=128m
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=64

